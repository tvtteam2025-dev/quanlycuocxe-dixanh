[Unit]
Description=QuanLyCuocXe FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/quanlycuocxe
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/quanlycuocxe/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8021 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

